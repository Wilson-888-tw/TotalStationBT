<?xml version="1.0" encoding="utf-8"?>
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- 工具列常駐按鈕 -->
    <group android:id="@+id/group_map_actions">
        <item
            android:id="@+id/menu_zoom_fit"
            android:title="縮放至全視窗"
            android:icon="@drawable/ic_zoom_out_map"
            app:showAsAction="always" />
        <item
            android:id="@+id/menu_help"
            android:title="操作說明"
            android:icon="@drawable/ic_help"
            app:showAsAction="always" />
        <item
            android:id="@+id/menu_points"
            android:title="點位清單"
            android:icon="@drawable/ic_bluetooth_search"
            app:showAsAction="always" />
    </group>

    <!-- 溢出選單 -->
    <group android:id="@+id/group_map_options">
        <item
            android:id="@+id/menu_show_lines"
            android:title="顯示原始連線"
            android:checkable="true"
            android:checked="true"
            app:showAsAction="never" />
        <item
            android:id="@+id/menu_elevation_color"
            android:title="海拔高程色帶"
            android:checkable="true"
            android:checked="false"
            app:showAsAction="never" />
        <item
            android:id="@+id/menu_toggle_3d"
            android:title="切換 3D 視圖"
            android:checkable="true"
            android:checked="false"
            app:showAsAction="never" />
        <item
            android:id="@+id/menu_load_dxf"
            android:title="載入底圖 (.dxf)"
            app:showAsAction="never" />
        <item
            android:id="@+id/menu_dxf_layers"
            android:title="底圖圖層設定"
            app:showAsAction="never" />
        <item
            android:id="@+id/menu_playback"
            android:title="測量軌跡回放"
            android:checkable="true"
            android:checked="false"
            app:showAsAction="never" />
        <item
            android:id="@+id/menu_baseline_list"
            android:title="顯示里程偏移表"
            app:showAsAction="never" />
        <item
            android:id="@+id/menu_dxf_realign"
            android:title="重新設定底圖對齊"
            app:showAsAction="never" />
        <item
            android:id="@+id/menu_clear_dxf"
            android:title="清除底圖"
            app:showAsAction="never" />
        <item
            android:id="@+id/menu_dxf_query"
            android:title="CAD 查詢（點選圖元）"
            android:checkable="true"
            android:checked="false"
            app:showAsAction="never" />
        <item
            android:id="@+id/menu_dxf_snap"
            android:title="CAD 放樣（端點/交點/圓心）"
            android:checkable="true"
            android:checked="false"
            app:showAsAction="never" />
        <item
            android:id="@+id/menu_dxf_measure"
            android:title="CAD 量測（連續捕捉計算）"
            android:checkable="true"
            android:checked="false"
            app:showAsAction="never" />
        <item
            android:id="@+id/menu_dxf_measure_result"
            android:title="顯示量測結果"
            app:showAsAction="never" />
        <item
            android:id="@+id/menu_dxf_measure_undo"
            android:title="刪除最後一個量測點"
            app:showAsAction="never" />
        <item
            android:id="@+id/menu_dxf_measure_clear"
            android:title="清除所有量測點"
            app:showAsAction="never" />
        <item
            android:id="@+id/menu_dxf_relative"
            android:title="放樣點與CAD選取點 (兩點計算)"
            android:checkable="true"
            android:checked="false"
            app:showAsAction="never" />
        <item
            android:id="@+id/menu_dxf_relative_clear"
            android:title="清除相對位置基準點"
            app:showAsAction="never" />
        <item
            android:id="@+id/menu_dxf_batch_list"
            android:title="CAD 批次放樣清單"
            app:showAsAction="never" />
    </group>

</menu>
