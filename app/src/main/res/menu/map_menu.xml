<?xml version="1.0" encoding="utf-8"?>
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- 工具列常駐按鈕 -->
    <group android:id="@+id/group_map_actions">
        <item
            android:id="@+id/menu_zoom_fit"
            android:title="縮放至全視窗"
            android:icon="@drawable/ic_zoom_out_map"
            app:showAsAction="always" />
        <item
            android:id="@+id/menu_scan_qr"
            android:title="掃描儀器手 QR"
            android:icon="@drawable/ic_camera_row"
            app:showAsAction="always" />
        <item
            android:id="@+id/menu_points"
            android:title="點位清單"
            android:icon="@drawable/ic_bluetooth_search"
            app:showAsAction="always" />
    </group>

    <!-- 溢出選單 -->
    <group android:id="@+id/group_map_options">
        <item
            android:id="@+id/menu_show_lines"
            android:title="顯示原始連線"
            android:checkable="true"
            android:checked="true"
            app:showAsAction="never" />
        <item
            android:id="@+id/menu_elevation_color"
            android:title="海拔高程色帶"
            android:checkable="true"
            android:checked="false"
            app:showAsAction="never" />
        <item
            android:id="@+id/menu_toggle_3d"
            android:title="切換 3D 視圖"
            android:checkable="true"
            android:checked="false"
            app:showAsAction="never" />
        <item
            android:id="@+id/menu_load_dxf"
            android:title="載入底圖 (.dxf)"
            app:showAsAction="never" />
        <item
            android:id="@+id/menu_clear_dxf"
            android:title="清除底圖"
            app:showAsAction="never" />
        <item
            android:id="@+id/menu_dxf_query"
            android:title="DXF 查詢（點選圖元）"
            android:checkable="true"
            android:checked="false"
            app:showAsAction="never" />
        <item
            android:id="@+id/menu_dxf_snap"
            android:title="DXF 捕捉點（端點/交點/圓心）"
            android:checkable="true"
            android:checked="false"
            app:showAsAction="never" />
        <item
            android:id="@+id/menu_dxf_measure"
            android:title="DXF 量測（連續捕捉計算）"
            android:checkable="true"
            android:checked="false"
            app:showAsAction="never" />
        <item
            android:id="@+id/menu_dxf_measure_result"
            android:title="顯示量測結果"
            app:showAsAction="never" />
        <item
            android:id="@+id/menu_dxf_measure_undo"
            android:title="刪除最後一個量測點"
            app:showAsAction="never" />
        <item
            android:id="@+id/menu_dxf_measure_clear"
            android:title="清除所有量測點"
            app:showAsAction="never" />
        <item
            android:id="@+id/menu_dxf_relative"
            android:title="DXF 相對位置（兩點計算）"
            android:checkable="true"
            android:checked="false"
            app:showAsAction="never" />
        <item
            android:id="@+id/menu_dxf_relative_clear"
            android:title="清除相對位置基準點"
            app:showAsAction="never" />
    </group>

    <!-- 線段編輯（旋轉 / 平行拉伸） -->
    <group android:id="@+id/group_line_edit">
        <item
            android:id="@+id/menu_line_edit"
            android:title="線段編輯模式"
            android:checkable="true"
            android:checked="false"
            app:showAsAction="never" />
        <item
            android:id="@+id/menu_line_from_points"
            android:title="由選取點建立線段"
            app:showAsAction="never" />
        <item
            android:id="@+id/menu_line_rotate_value"
            android:title="旋轉線段（輸入角度）"
            app:showAsAction="never" />
        <item
            android:id="@+id/menu_line_stretch_value"
            android:title="平行拉伸（輸入距離）"
            app:showAsAction="never" />
        <item
            android:id="@+id/menu_line_rotate_shape"
            android:title="整體旋轉圖形（輸入角度）"
            app:showAsAction="never" />
        <item
            android:id="@+id/menu_line_info"
            android:title="線段成果（座標／長度／方位角）"
            app:showAsAction="never" />
        <item
            android:id="@+id/menu_line_undo"
            android:title="復原線段編輯"
            app:showAsAction="never" />
        <item
            android:id="@+id/menu_line_delete"
            android:title="刪除選取線段"
            app:showAsAction="never" />
        <item
            android:id="@+id/menu_line_clear"
            android:title="清除全部線段"
            app:showAsAction="never" />
    </group>

</menu>
