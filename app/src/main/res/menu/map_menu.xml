<?xml version="1.0" encoding="utf-8"?>
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- 工具列常駐按鈕 -->
    <group android:id="@+id/group_map_actions">
        <item
            android:id="@+id/menu_zoom_fit"
            android:title="縮放至全視窗"
            android:icon="@drawable/ic_zoom_out_map"
            app:showAsAction="always" />
        <item
            android:id="@+id/menu_points"
            android:title="點位清單"
            android:icon="@drawable/ic_bluetooth_search"
            app:showAsAction="always" />
    </group>

    <!-- 溢出選單 -->
    <group android:id="@+id/group_map_options">
        <item
            android:id="@+id/menu_show_lines"
            android:title="顯示原始連線"
            android:checkable="true"
            android:checked="true"
            app:showAsAction="never" />
        <item
            android:id="@+id/menu_elevation_color"
            android:title="海拔高程色帶"
            android:checkable="true"
            android:checked="false"
            app:showAsAction="never" />
        <item
            android:id="@+id/menu_toggle_3d"
            android:title="切換 3D 視圖"
            android:checkable="true"
            android:checked="false"
            app:showAsAction="never" />
        <item
            android:id="@+id/menu_load_dxf"
            android:title="載入底圖 (.dxf)"
            app:showAsAction="never" />
        <item
            android:id="@+id/menu_clear_dxf"
            android:title="清除底圖"
            app:showAsAction="never" />
        <item
            android:id="@+id/menu_dxf_query"
            android:title="DXF 查詢（點選圖元）"
            android:checkable="true"
            android:checked="false"
            app:showAsAction="never" />
        <item
            android:id="@+id/menu_dxf_snap"
            android:title="DXF 捕捉點（端點/交點/圓心）"
            android:checkable="true"
            android:checked="false"
            app:showAsAction="never" />
        <item
            android:id="@+id/menu_dxf_measure"
            android:title="DXF 量測（連續捕捉計算）"
            android:checkable="true"
            android:checked="false"
            app:showAsAction="never" />
        <item
            android:id="@+id/menu_dxf_measure_result"
            android:title="顯示量測結果"
            app:showAsAction="never" />
        <item
            android:id="@+id/menu_dxf_measure_undo"
            android:title="刪除最後一個量測點"
            app:showAsAction="never" />
        <item
            android:id="@+id/menu_dxf_measure_clear"
            android:title="清除所有量測點"
            app:showAsAction="never" />
        <item
            android:id="@+id/menu_dxf_relative"
            android:title="DXF 相對位置（兩點計算）"
            android:checkable="true"
            android:checked="false"
            app:showAsAction="never" />
        <item
            android:id="@+id/menu_dxf_relative_clear"
            android:title="清除相對位置基準點"
            app:showAsAction="never" />
    </group>

</menu>
