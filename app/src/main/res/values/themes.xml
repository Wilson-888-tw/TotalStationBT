<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TotalStationBT" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- M3 Primary -->
        <item name="colorPrimary">@color/md3_primary</item>
        <item name="colorOnPrimary">@color/md3_on_primary</item>
        <item name="colorPrimaryContainer">@color/md3_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/md3_on_primary_container</item>

        <!-- M3 Secondary -->
        <item name="colorSecondary">@color/md3_secondary</item>
        <item name="colorOnSecondary">@color/md3_on_secondary</item>
        <item name="colorSecondaryContainer">@color/md3_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/md3_on_secondary_container</item>

        <!-- M3 Surface -->
        <item name="colorSurface">@color/md3_surface</item>
        <item name="colorOnSurface">@color/md3_on_surface</item>
        <item name="colorSurfaceVariant">@color/md3_surface_container_high</item>
        <item name="colorOnSurfaceVariant">@color/md3_on_surface_variant</item>
        <item name="colorSurfaceContainer">@color/md3_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/md3_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/md3_surface_container_highest</item>

        <!-- M3 Outline -->
        <item name="colorOutline">@color/md3_outline</item>
        <item name="colorOutlineVariant">@color/md3_outline_variant</item>

        <!-- M3 Error -->
        <item name="colorError">@color/md3_error</item>
        <item name="colorOnError">@color/md3_on_error</item>
        <item name="colorErrorContainer">@color/md3_error_container</item>
        <item name="colorOnErrorContainer">@color/md3_on_error_container</item>

        <!-- Background -->
        <item name="android:colorBackground">@color/md3_surface</item>
        <item name="android:windowBackground">@color/md3_surface</item>

        <!-- M2 compat -->
        <item name="colorAccent">@color/md3_secondary</item>
        <item name="colorPrimaryDark">@color/md3_primary_container</item>
    </style>

    <!-- TopAppBar: 深色表面，M3 風格 -->
    <style name="AppBar.TotalStation" parent="Widget.MaterialComponents.Toolbar.Surface">
        <item name="android:background">@color/md3_surface_container</item>
        <item name="titleTextColor">@color/md3_on_surface</item>
        <item name="navigationIconTint">@color/md3_on_surface</item>
        <item name="android:elevation">0dp</item>
    </style>

    <!-- 統計數字大字 -->
    <style name="TextAppearance.Metric.Number" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- 底部 BottomSheet -->
    <style name="BottomSheet.TotalStation" parent="Widget.Material3.BottomSheet">
        <item name="android:background">@color/md3_surface_container_high</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.BottomSheet</item>
    </style>

    <style name="ShapeAppearance.BottomSheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">20dp</item>
        <item name="cornerSizeTopRight">20dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
</resources>
