<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingTop="24dp"
    android:paddingBottom="8dp"
    android:paddingHorizontal="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="WiFi 中繼"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/md3_on_surface"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="讓桿子手掃描以連線"
        android:textSize="13sp"
        android:textColor="@color/md3_on_surface_variant"
        android:layout_marginBottom="16dp"/>

    <!-- QR Code 圖片 -->
    <ImageView
        android:id="@+id/imgQrCode"
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:background="@android:color/white"
        android:padding="8dp"
        android:layout_marginBottom="12dp"
        android:contentDescription="QR Code"/>

    <!-- IP:Port 文字（供手動輸入參考） -->
    <TextView
        android:id="@+id/tvQrIpPort"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="192.168.43.1:7890"
        android:textColor="@color/md3_on_surface_variant"
        android:textSize="13sp"
        android:fontFamily="monospace"
        android:layout_marginBottom="10dp"/>

    <!-- 連線人數 -->
    <TextView
        android:id="@+id/tvClientCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="等待連線…"
        android:textColor="@color/md3_on_surface_variant"
        android:textSize="14sp"
        android:layout_marginBottom="4dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStopRelay"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="停止中繼"
        android:textColor="@color/md3_error"/>

</LinearLayout>
