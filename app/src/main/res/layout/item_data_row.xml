<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="8dp"
    android:paddingStart="4dp"
    android:paddingEnd="8dp"
    android:gravity="center_vertical"
    android:background="?attr/selectableItemBackground">

    <!-- 選項勾選框 -->
    <CheckBox
        android:id="@+id/checkItem"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:buttonTint="@color/md3_secondary" />

    <!-- 狀態指示條 -->
    <View
        android:id="@+id/indicator"
        android:layout_width="3dp"
        android:layout_height="40dp"
        android:layout_marginEnd="12dp"
        android:background="@color/status_connected" />

    <!-- 文字內容區 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom"
            android:layout_marginBottom="2dp">

            <TextView
                android:id="@+id/tvTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="@color/text_hint"
                android:fontFamily="monospace"
                android:layout_marginEnd="12dp" />

            <TextView
                android:id="@+id/tvRaw"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="@color/text_hint"
                android:fontFamily="monospace"
                android:singleLine="true"
                android:alpha="0.7"
                android:ellipsize="end" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvParsed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/md3_on_surface"
            android:textStyle="bold"
            android:visibility="gone"
            android:lineSpacingExtra="2dp" />

    </LinearLayout>

    <!-- 右側按鈕區 -->
    <LinearLayout
        android:id="@+id/layoutActions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:visibility="gone"
        android:layout_marginStart="8dp">

        <ImageView
            android:id="@+id/btnRowPhoto"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_camera_row"
            app:tint="@color/md3_secondary"
            android:padding="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="拍照/相簿" />

        <ImageView
            android:id="@+id/btnRowShare"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_share_point"
            app:tint="@color/md3_on_surface_variant"
            android:padding="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="分享" />

    </LinearLayout>

</LinearLayout>
