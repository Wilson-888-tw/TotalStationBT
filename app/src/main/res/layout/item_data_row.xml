<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="6dp"
    android:paddingEnd="12dp"
    android:gravity="center_vertical"
    android:background="?attr/selectableItemBackground">

    <!-- 選項勾選框 -->
    <CheckBox
        android:id="@+id/checkItem"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:buttonTint="@color/md3_secondary" />

    <!-- 狀態指示條 -->
    <View
        android:id="@+id/indicator"
        android:layout_width="3dp"
        android:layout_height="36dp"
        android:layout_marginEnd="10dp"
        android:background="@color/status_connected" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingVertical="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textColor="@color/text_hint"
                android:fontFamily="monospace"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tvRaw"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="12sp"
                android:textColor="@color/md3_on_surface"
                android:fontFamily="monospace"
                android:singleLine="true"
                android:ellipsize="end" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvParsed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/md3_secondary"
            android:visibility="gone"
            android:paddingTop="2dp" />

        <LinearLayout
            android:id="@+id/layoutActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:visibility="gone"
            android:paddingTop="4dp">

            <ImageView
                android:id="@+id/btnRowPhoto"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_camera_row"
                app:tint="@color/md3_secondary"
                android:padding="4dp"
                android:layout_marginEnd="16dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="拍照" />

            <ImageView
                android:id="@+id/btnRowShare"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_share_point"
                app:tint="@color/md3_on_surface_variant"
                android:padding="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="分享" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
