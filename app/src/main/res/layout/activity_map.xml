<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 主地圖內容 -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_primary">

        <!-- ── TopAppBar ────────────────────────────── -->
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBarLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/md3_surface_container"
            app:elevation="0dp">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:title="2D 平面圖"
                app:titleCentered="true"
                app:titleTextAppearance="@style/TextAppearance.Material3.TitleLarge"
                app:titleTextColor="@color/md3_on_surface" />

        </com.google.android.material.appbar.AppBarLayout>

        <!-- ── 地圖畫布 ──────────────────────────────── -->
        <com.survey.totalstationbt.ui.SurveyCanvasView
            android:id="@+id/canvasView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior" />

        <!-- ── 3D 視角快捷列（SegmentedButton） ──────── -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleGroup3dPresets"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            android:elevation="6dp"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"
            app:singleSelection="true"
            app:selectionRequired="false">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewTop"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:paddingHorizontal="16dp"
                android:text="俯視"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewFront"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:paddingHorizontal="16dp"
                android:text="正視"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewSide"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:paddingHorizontal="16dp"
                android:text="側視"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewIso"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:paddingHorizontal="16dp"
                android:text="等角"
                android:textSize="12sp" />

        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- ── FAB ──────────────────────────────────── -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabCalc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:contentDescription="量測"
            android:visibility="gone"
            app:backgroundTint="@color/md3_secondary_container"
            app:srcCompat="@drawable/ic_measure"
            app:tint="@color/md3_on_secondary_container" />

        <!-- ── 軌跡回放控制面板 ───────────────────── -->
        <LinearLayout
            android:id="@+id/cardPlayback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/md3_surface_container_high"
            android:orientation="vertical"
            android:visibility="gone"
            android:elevation="8dp"
            android:layout_gravity="bottom"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPlayPause"
                    style="@style/Widget.Material3.Button.Icon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    app:icon="@drawable/ic_play"
                    android:contentDescription="播放" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderPlayback"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="8dp"
                    android:valueFrom="0"
                    android:valueTo="1"
                    android:value="1" />

                <TextView
                    android:id="@+id/tvPlaybackInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="100%"
                    android:textColor="@color/md3_on_surface"
                    android:textSize="12sp"
                    android:minWidth="40dp"
                    android:gravity="end" />

            </LinearLayout>

        </LinearLayout>

        <!-- ── 放樣導引 BottomSheet ─────────────────── -->
        <LinearLayout
            android:id="@+id/cardStakeout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/md3_surface_container_high"
            android:orientation="vertical"
            app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
            app:behavior_hideable="true"
            app:behavior_peekHeight="0dp"
            app:behavior_skipCollapsed="true"
            android:paddingTop="8dp">

            <!-- 拖曳把手 -->
            <View
                android:layout_width="32dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bottom_sheet_handle" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingBottom="16dp">

                <!-- 標題列 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/tvStakeoutTarget"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="正在放樣：PT001"
                        android:textColor="@color/md3_on_surface"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvStakeoutProgress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:text="(1/1)"
                        android:textColor="@color/md3_on_surface_variant"
                        android:textSize="12sp"
                        android:visibility="gone" />

                    <CheckBox
                        android:id="@+id/checkElevationOnly"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="僅提示填挖"
                        android:textColor="@color/md3_on_surface_variant"
                        android:textSize="12sp"
                        android:buttonTint="@color/md3_secondary" />

                </LinearLayout>

                <!-- 分隔線 -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider"
                    android:layout_marginBottom="12dp" />

                <!-- 導引資訊列 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/imgDirection"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:src="@drawable/ic_zoom_out_map"
                        app:tint="@color/status_connecting" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">

                        <TextView
                            android:id="@+id/tvDistDelta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="距離目標：1.234 m"
                            android:textColor="@color/status_connected"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvHeightDelta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="填挖：+0.050 m"
                            android:textColor="@color/md3_on_surface_variant"
                            android:textSize="14sp"
                            android:layout_marginTop="2dp" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layoutBatchControls"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:visibility="gone"
                        android:layout_marginEnd="8dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPrevStakeout"
                            style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginEnd="4dp"
                            app:icon="@drawable/ic_chevron_left"
                            android:contentDescription="上一個"
                            app:iconPadding="0dp"
                            app:iconSize="20dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnNextStakeout"
                            style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            app:icon="@drawable/ic_chevron_right"
                            android:contentDescription="下一個"
                            app:iconPadding="0dp"
                            app:iconSize="20dp" />

                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnShareStakeout"
                        style="@style/Widget.Material3.Button.IconButton.Outlined"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="8dp"
                        app:icon="@drawable/ic_share_point"
                        android:contentDescription="分享導引"
                        app:iconPadding="0dp"
                        app:iconSize="20dp"
                        app:strokeColor="@color/md3_secondary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStopStakeout"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="停止"
                        android:textColor="@color/md3_error"
                        app:strokeColor="@color/md3_error" />

                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- ── 側邊點位列表（抽屜） ──────────────────────── -->
    <LinearLayout
        android:layout_width="288dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@color/md3_surface_container_high"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical">

        <!-- 側欄標題 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/md3_surface_container"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="圖層與設定"
                android:textColor="@color/md3_on_surface"
                android:textSize="17sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- 底圖透明度 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:background="@color/md3_surface_container">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="底圖透明度"
                android:textColor="@color/md3_on_surface_variant"
                android:textSize="12sp"
                android:layout_marginBottom="4dp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderDxfAlpha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="0"
                android:valueTo="255"
                android:stepSize="1"
                android:value="200" />

        </LinearLayout>

        <!-- 全選 / 全取消 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:background="@color/md3_surface_container">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSelectAll"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="全選"
                android:textSize="13sp"
                android:textColor="@color/md3_secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClearAll"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="全取消"
                android:textSize="13sp"
                android:textColor="@color/md3_primary" />

        </LinearLayout>

        <!-- 分隔線 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />

        <!-- 搜尋欄 -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPointSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
            android:hint="搜尋點號或編碼…"
            android:paddingHorizontal="8dp"
            android:paddingTop="6dp"
            android:paddingBottom="4dp"
            app:boxStrokeColor="@color/md3_secondary"
            app:hintTextColor="@color/md3_on_surface_variant"
            app:boxCornerRadiusTopStart="8dp"
            app:boxCornerRadiusTopEnd="8dp"
            app:boxCornerRadiusBottomStart="8dp"
            app:boxCornerRadiusBottomEnd="8dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPointSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/md3_on_surface"
                android:textColorHint="@color/text_hint"
                android:textSize="13sp"
                android:inputType="text"
                android:maxLines="1"
                android:imeOptions="actionSearch" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- 分隔線 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerPointList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingTop="4dp"
            android:clipToPadding="false" />

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
